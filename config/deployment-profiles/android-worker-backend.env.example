# ATP 公网 Backend/Beat/普通 Linux Worker：Android 任务派发给 Windows Android Worker。
# 不要把此文件直接作为 Windows Android Agent 配置；Agent 使用 startup-profiles/android-agent.env.example。
APP_ENV=production

POSTGRES_HOST=<server-host>
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_DB=atp
POSTGRES_USER=atp
POSTGRES_PASSWORD=change_me

REDIS_HOST=<server-host>
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_CONNECT_TIMEOUT_SECONDS=5

MINIO_HOST=<server-host>
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=atp
MINIO_CONNECT_TIMEOUT_SECONDS=5

# 必须与 Windows Agent 使用同一组密钥。
APP_SECRET_KEY=use_the_same_value_across_atp_processes
ENCRYPTION_KEY=use_the_same_value_across_atp_processes
APP_CORS_ORIGINS=https://<public-web-host>

# 普通 Linux Worker 不得消费 Android 队列；mobile_special 由 Windows Agent 消费。
CELERY_QUEUES=default,ios,ai,maintenance,performance
ADB_SCAN_ENABLED=true
ADB_SCAN_MODE=worker
ANDROID_WORKER_QUEUE=mobile_special
ANDROID_WORKER_REGISTRY_PREFIX=atp:android-worker
ANDROID_WORKER_HEARTBEAT_SECONDS=15
ANDROID_WORKER_TTL_SECONDS=45

# Linux Web 录制使用独立 Worker 时启用；没有 web-recorder 服务时保持 local。
WEB_RECORDER_MODE=worker
WEB_RECORDER_WORKER_QUEUE_PREFIX=atp:web-recording:commands
WEB_RECORDER_WORKER_ID=
WEB_RECORDER_WORKER_MAX_SESSIONS=2
WEB_RECORDER_WORKER_HEARTBEAT_SECONDS=5
WEB_RECORDER_WORKER_TTL_SECONDS=20
WEB_RECORDER_COMMAND_TIMEOUT_SECONDS=45
WEB_RECORDER_REPLY_TTL_SECONDS=60
WEB_RECORDER_SESSION_TTL_SECONDS=3600

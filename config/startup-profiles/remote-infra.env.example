# Windows 全量开发：应用进程在本机，PostgreSQL/Redis/MinIO 位于远程主机。
# 请将 <server-host> 替换为实际内网/VPN/DNS 地址，不要直接暴露基础设施到公网。
APP_ENV=development
POSTGRES_HOST=<server-host>
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_DB=atp
POSTGRES_USER=atp
POSTGRES_PASSWORD=change_me
REDIS_HOST=<server-host>
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_CONNECT_TIMEOUT_SECONDS=5
MINIO_HOST=<server-host>
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=atp
MINIO_CONNECT_TIMEOUT_SECONDS=5
APP_SECRET_KEY=use_the_same_value_as_the_backend
ENCRYPTION_KEY=use_the_same_value_as_the_backend
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CELERY_QUEUES=default,android,mobile_special,ios,ai,maintenance,performance
WEB_RECORDER_MODE=local
WEB_RECORDER_WORKER_QUEUE_PREFIX=atp:web-recording:commands
WEB_RECORDER_WORKER_ID=
WEB_RECORDER_WORKER_MAX_SESSIONS=2
WEB_RECORDER_WORKER_HEARTBEAT_SECONDS=5
WEB_RECORDER_WORKER_TTL_SECONDS=20
WEB_RECORDER_COMMAND_TIMEOUT_SECONDS=45
WEB_RECORDER_REPLY_TTL_SECONDS=60
WEB_RECORDER_SESSION_TTL_SECONDS=3600
WEB_RECORDER_DISPLAY=
ADB_SCAN_ENABLED=true
ADB_SCAN_MODE=local
ANDROID_WORKER_ID=
ANDROID_WORKER_QUEUE=mobile_special
ANDROID_WORKER_REGISTRY_PREFIX=atp:android-worker
ANDROID_WORKER_HEARTBEAT_SECONDS=15
ANDROID_WORKER_TTL_SECONDS=45
VITE_BACKEND_ORIGIN=

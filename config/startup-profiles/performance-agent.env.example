# Windows performance Agent：只启动本机性能 Worker，消费独立节点队列。
# Backend、PostgreSQL、Redis 和 MinIO 可以部署在远程主机；Worker 本机执行性能脚本。
APP_ENV=production
POSTGRES_HOST=<server-host>
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_DB=atp
POSTGRES_USER=atp
POSTGRES_PASSWORD=change_me
REDIS_HOST=<server-host>
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_CONNECT_TIMEOUT_SECONDS=5
MINIO_HOST=<server-host>
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=atp
MINIO_CONNECT_TIMEOUT_SECONDS=5
APP_SECRET_KEY=use_the_same_value_as_the_backend
ENCRYPTION_KEY=use_the_same_value_as_the_backend
CELERY_QUEUES=performance.worker-a
PERFORMANCE_NODE_ENABLED=true
PERFORMANCE_NODE_ID=performance-win-worker-a
PERFORMANCE_NODE_NAME=Windows 性能节点 A
PERFORMANCE_NODE_QUEUE=performance.worker-a
PERFORMANCE_EXECUTORS=jmeter,grpc
PERFORMANCE_NODE_MAX_VUS=50
PERFORMANCE_NODE_MAX_CONCURRENCY=1
PERFORMANCE_NODE_EGRESS_ALLOWLIST=127.0.0.1,localhost
WORKER_METRICS_PORT=0

# Copy to a macOS Worker-only env file and fill the external Redis/database values.
# Do not commit a real password, Appium URL or signing credential.
APP_ENV=production
CELERY_QUEUES=ios
ADB_SCAN_ENABLED=false
PERFORMANCE_NODE_ENABLED=false
WEB_RECORDER_MODE=local

REDIS_HOST=atp-backend.example.test
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_CONNECT_TIMEOUT_SECONDS=5
CELERY_BROKER_URL=redis://:change-me@atp-backend.example.test:6379/0
CELERY_RESULT_BACKEND=redis://:change-me@atp-backend.example.test:6379/1

POSTGRES_HOST=atp-backend.example.test
POSTGRES_PORT=5432
POSTGRES_DB=atp
POSTGRES_USER=atp
POSTGRES_PASSWORD=change-me

MINIO_HOST=atp-backend.example.test
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=atp

# The Appium server stays on this macOS host; register its reachable address
# in System Management -> iOS Devices, not in this file.
APPIUM_SERVER_URL=http://127.0.0.1:4723

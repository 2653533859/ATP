# Copy to .env.performance-acceptance and replace every change-me value.
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-random-32-character-secret
APP_AUTO_CREATE_TABLES=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=atp_acceptance
POSTGRES_USER=atp
POSTGRES_PASSWORD=change-me-postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=atp

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-admin
FIRST_ADMIN_EMAIL=admin@example.com

CELERY_CONCURRENCY=1
CELERY_QUEUES=performance.worker-a
WORKER_METRICS_PORT=9092
PERFORMANCE_EXECUTORS=k6,locust,grpc,jmeter
PERFORMANCE_NODE_ENABLED=true
PERFORMANCE_NODE_ID=worker-a
PERFORMANCE_NODE_NAME=Acceptance Worker A
PERFORMANCE_NODE_QUEUE=performance.worker-a
PERFORMANCE_NODE_MAX_VUS=20
PERFORMANCE_NODE_MAX_CONCURRENCY=1
PERFORMANCE_NODE_EGRESS_ALLOWLIST=grpc-target,http-target
PERFORMANCE_TARGET_ALLOWLIST=grpc-target,http-target
PERFORMANCE_METRICS_ENABLED=true
PERFORMANCE_METRICS_INTERVAL_SECONDS=5
PERFORMANCE_METRICS_MAX_SAMPLES=7200
PERFORMANCE_MINIO_INVENTORY_INTERVAL_SECONDS=30

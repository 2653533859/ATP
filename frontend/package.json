{
  "name": "atp-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:browser-matrix": "node tools/browser-matrix-smoke.mjs",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@monaco-editor/loader": "^1.4.0",
    "ant-design-vue": "^4.2.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "form-data": "4.0.6",
    "glob": "^13.0.6",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  },
  "allowScripts": {
    "core-js": true,
    "fsevents": true,
    "vue-demi": true
  }
}

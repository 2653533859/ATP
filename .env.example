# ================================
# ATP - Automated Testing Platform
# 环境变量配置（复制此文件为 .env 并填写实际值）
# ================================

# --- 数据库 ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=atp
POSTGRES_USER=atp
POSTGRES_PASSWORD=atp_password_change_me

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO ---
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_password_change_me
MINIO_BUCKET=atp

# --- 后端应用 ---
# 本地直跑建议使用 development；Docker Compose 生产编排会覆盖为 production
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
APP_ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
APP_AUTO_CREATE_TABLES=false

# --- Celery Worker ---
CELERY_CONCURRENCY=4
CELERY_QUEUES=default,mobile_special,ai,maintenance,performance
WORKER_METRICS_PORT=9091

# --- SMTP 邮件通知 ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
SMTP_TLS=false

# --- 初始管理员账号（首次启动自动创建）---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin@123456
FIRST_ADMIN_EMAIL=admin@example.com

# --- CI/CD Webhook ---
WEBHOOK_API_KEY=change_this_to_a_random_webhook_key

# --- 加密（可选，留空自动从 APP_SECRET_KEY 派生）---
ENCRYPTION_KEY=

# --- 文件保留天数 ---
FILE_RETENTION_DAYS=30
STALE_PENDING_CLEANUP_ENABLED=true
STALE_PENDING_TIMEOUT_MINUTES=120
STALE_PENDING_CLEANUP_INTERVAL_SECONDS=600

# --- 终态运行记录清理（PlanRun / SuiteRun / TestRun / MobileSpecialRun）---
# RUN_CLEANUP_ENABLED=false 时禁用每日的 cleanup_old_completed_runs 任务
RUN_CLEANUP_ENABLED=true
# 终态运行记录与其 MinIO 截图/产物的保留天数
RUN_RETENTION_DAYS=90
# 单批最多删除多少行，控制事务大小
RUN_CLEANUP_BATCH_SIZE=500

# --- 存储使用率告警（MinIO bucket 总大小超过阈值时通知管理员）---
# 单位 GB，0 表示不告警
STORAGE_ALERT_SIZE_GB=0
# 触发间隔（秒），避免反复告警
STORAGE_ALERT_INTERVAL_SECONDS=3600
# 单次告警扫描的最大对象数，超过即放弃本次计算（保护 MinIO list_objects 性能）
STORAGE_ALERT_MAX_SCAN_OBJECTS=100000

# Dashboard alert suppression default in minutes
DASHBOARD_ALERT_DEFAULT_SUPPRESS_MIN=60

# --- AI 自愈 ---
AI_HEALING_ENABLED=false
AI_HEALING_TIMEOUT_SECONDS=60
AI_HEALING_DAILY_LIMIT=100
AI_HEALING_CACHE_TTL_SECONDS=3600
AI_HEALING_FEW_SHOT_ENABLED=true
AI_HEALING_FEW_SHOT_TOP_N=3
AI_HEALING_VISION_ENABLED=false
AI_HEALING_VISION_DAILY_LIMIT=50

# --- Performance Center guardrails ---
# Comma-separated hostnames; empty allows all targets for local development.
PERFORMANCE_TARGET_ALLOWLIST=
PERFORMANCE_MAX_VUS=50
PERFORMANCE_MAX_DURATION_SECONDS=900

# --- ADB 设备扫描 ---
ADB_SCAN_ENABLED=true
ADB_SCAN_INTERVAL=15
ADB_RECONNECT_ENABLED=true
ADB_RECONNECT_MAX_ATTEMPTS=3
ADB_RECONNECT_BACKOFF_MS=200,800,2000
ADB_HEARTBEAT_ENABLED=true
ADB_HEARTBEAT_INTERVAL_SEC=15
ADB_HEARTBEAT_FAILURE_THRESHOLD=2

# --- 限流配置 ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_WEBHOOK=30/minute

# --- 日志级别（可选，留空按 APP_ENV 自动选择）---
LOG_LEVEL=

# --- 慢查询日志 ---
SLOW_QUERY_LOG_ENABLED=true
SLOW_QUERY_THRESHOLD_MS=1000

# --- 用例快照保留 ---
CASE_SNAPSHOT_MAX_PER_CASE=50

# --- Mock Server 独立端口（0 表示关闭独立端口）---
MOCK_STANDALONE_PORT=0

# --- PostgreSQL 自动备份（默认关闭）---
DB_BACKUP_ENABLED=false
DB_BACKUP_RETAIN_DAILY=7
DB_BACKUP_RETAIN_WEEKLY=4
DB_BACKUP_PREFIX=pg-backups

# --- OpenTelemetry / Jaeger ---
# 留空时不初始化 OTel；Docker Compose 默认会覆盖到 jaeger:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=atp-backend
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
JAEGER_UI_URL=

# --- 前端开发可选配置 ---
# 留空时开发模式默认请求 http://localhost:8000；生产模式使用当前域名
VITE_BACKEND_ORIGIN=

# MinIO cross-endpoint recovery inputs for the real Kubernetes acceptance run.
# Do not source this file unchanged. Copy it, replace every CHANGE-ME value via
# the secret manager, and source the copy only on the acceptance operator host.

# SOURCE must match the ATP release Secret's MINIO_HOST/MINIO_PORT/MINIO_BUCKET.
ATP_MINIO_DR_SOURCE_ENDPOINT=source-minio.example.test:9000
ATP_MINIO_DR_SOURCE_ACCESS_KEY=CHANGE-ME-SOURCE-ACCESS-KEY
ATP_MINIO_DR_SOURCE_SECRET_KEY=CHANGE-ME-SOURCE-SECRET-KEY
ATP_MINIO_DR_SOURCE_BUCKET=atp
ATP_MINIO_DR_SOURCE_SECURE=false

# TARGET must be a different host/IP and bucket from SOURCE.
ATP_MINIO_DR_TARGET_ENDPOINT=target-minio.example.test:9000
ATP_MINIO_DR_TARGET_ACCESS_KEY=CHANGE-ME-TARGET-ACCESS-KEY
ATP_MINIO_DR_TARGET_SECRET_KEY=CHANGE-ME-TARGET-SECRET-KEY
ATP_MINIO_DR_TARGET_BUCKET=atp-dr
ATP_MINIO_DR_TARGET_SECURE=false

# ============================================================
# ATP 团队轻量版环境变量配置文件 (.env.lite)
# 适配: 3~15人开发与测试团队，重点启用 AI 智能体、RAG 知识库与测试管理
# ============================================================

# ── 1. 基础服务端口与环境 ──
APP_ENV=production
APP_SECRET_KEY=atp_team_lite_secret_key_change_in_production_2026
FRONTEND_PORT=80
BACKEND_PORT=8000
APP_CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# ── 2. 数据库与缓存配置 (PostgreSQL / Redis) ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=atp
POSTGRES_USER=atp
POSTGRES_PASSWORD=atp_team_password_2026

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 3. MinIO 对象存储 (测试产物与执行截图) ──
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_team_password_2026
MINIO_BUCKET=atp

# ── 4. 首次启动管理员账号 ──
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin@123456
FIRST_ADMIN_EMAIL=admin@example.com

# ── 5. Celery 异步队列 ──
CELERY_CONCURRENCY=2
CELERY_QUEUES=default,ai,maintenance
WEB_EXECUTION_QUEUE=default

# ── 6. AI 智能体与用例根因分析配置 ──
# 开启 AI 错误根因分析与智能自愈
AI_HEALING_ENABLED=true
AI_HEALING_TIMEOUT_SECONDS=60
AI_HEALING_DAILY_LIMIT=200

# 默认大模型提供商选型 (支持 deepseek, qwen, openai)
# 部署后亦可直接在系统界面【系统中心 -> 配置中心 -> 大模型配置】中可视化录入
DEFAULT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

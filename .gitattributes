# 默认所有文本文件使用 LF 换行（避免 Windows 上 commit 出现 CRLF 警告）
* text=auto eol=lf

# 显式指定常见源码类型为 LF
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
.env.example text eol=lf
Dockerfile* text eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.apk binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
